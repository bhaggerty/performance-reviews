# See src/config.ts for full validation/defaults. Every variable below is read there.

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token
# true = Socket Mode (no public inbound endpoint needed, uses SLACK_APP_TOKEN); false = HTTP Events API
USE_SOCKET_MODE=true
SLACK_WORKSPACE_ID=T00000000

# --- Web console "Sign in with Slack" (OpenID Connect) ---
SLACK_CLIENT_ID=1234567890.1234567890
SLACK_CLIENT_SECRET=your-oauth-client-secret

# --- App URL ---
# Used to build the OIDC redirect_uri and links in Slack messages.
APP_URL=http://localhost:3000

# --- AWS / DynamoDB ---
# In production, Union Station auto-injects AWS_REGION and APP_DYNAMODB_TABLE_NAME as plain
# runtime env vars — you do not set these yourself in a deployed environment. Set them here only
# for local development (or set DYNAMODB_TABLE instead, which always takes precedence).
AWS_REGION=us-east-1
DYNAMODB_TABLE=performance-reviews
APP_DYNAMODB_TABLE_NAME=
# Set only for local dev against DynamoDB Local, e.g. http://localhost:8000 (see LOCAL_DEV.md)
DYNAMODB_ENDPOINT=

# --- S3 (document archive) ---
S3_BUCKET=performance-reviews-docs
S3_PREFIX=Performance Reviews

# --- Optional private archive webhook (Google Drive / Apps Script or similar) ---
DOCUMENT_ARCHIVE_WEBHOOK_URL=
DOCUMENT_ARCHIVE_WEBHOOK_SECRET=

# --- AI review coach (optional; disabled by default) ---
# none | anthropic | openai
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_TIMEOUT_MS=4000
AI_MAX_RETRIES=1

# --- Primary Approver / People admin ---
# The Primary Approver's authenticated email must match this value AND be a People admin.
# Production refuses to start without this set.
PRIMARY_APPROVER_EMAIL=people-ops@example-corp.test
# Comma-separated list of additional People-admin emails (beyond employees flagged in the directory).
PEOPLE_ADMIN_EMAILS=

# --- Web console session/auth ---
WEB_SESSION_SECRET=replace-with-a-long-random-string
# true in any environment that terminates TLS in front of the app (always true in production).
WEB_COOKIE_SECURE=false
# DANGEROUS: only for a deliberately console-less local dev run. Production always fails
# closed if console auth isn't configured, regardless of this flag.
WEB_AUTH_DISABLED_INSECURE=false

# --- Automation API (disabled by default; see docs/SECURITY.md) ---
AUTOMATION_API_ENABLED=false
AUTOMATION_API_TOKEN=

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=debug

# --- Cycle defaults ---
DEFAULT_MAX_PEERS=3

# --- Runtime ---
PORT=3000
NODE_ENV=development
